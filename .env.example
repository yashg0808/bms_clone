# ============================================
# BookMyShow Clone - Environment Variables
# ============================================
# Copy this file to .env and update values
# cp .env.example .env

# ---- Database ----
POSTGRES_USER=bookmyshow
POSTGRES_PASSWORD=secret123
POSTGRES_DB=bookmyshow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Elasticsearch ----
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ---- JWT ----
JWT_SECRET=your-super-secret-key-change-in-production-must-be-at-least-256-bits
JWT_EXPIRATION=3600000

# ---- Payment Gateway (Razorpay) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=test_secret_xxxxxxxxxxxx

# ---- Payment Gateway (Stripe) ----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ---- Email (SendGrid) ----
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@bookmyshow.com

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ---- Service Ports ----
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
MOVIE_SERVICE_PORT=8082
BOOKING_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
